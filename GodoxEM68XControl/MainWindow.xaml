                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M9,11.24V7.5C9,6.12 10.12,5 11.5,5C12.88,5 14,6.12 14,7.5V11.24C15.21,10.43 16,9.06 16,7.5C16,5.01 13.99,3 11.5,3C9.01,3 7,5.01 7,7.5C7,9.06 7.79,10.43 9,11.24M18.84,15.87L14.3,13.61C14.13,13.53 13.93,13.5 13.74,13.5H13V7.5C13,6.67 12.33,6 11.5,6C10.67,6 10,6.67 10,7.5V18.24L6.6,17.22L5.9,17.93L10.93,22.95C11.3,23.3 11.8,23.5 12.31,23.5H17.5C18.5,23.5 19.35,22.76 19.48,21.77L20.23,16.3C20.23,15.65 19.43,16.17 18.84,15.87Z"
