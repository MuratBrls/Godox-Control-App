                                    <!-- Bidirectional -->
                                    <RadioButton x:Name="RbPickupBidirectional"
                                                 GroupName="PickupGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="4,0,4,0"
