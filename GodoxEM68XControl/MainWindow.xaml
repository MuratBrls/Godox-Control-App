                                            <TextBlock Text="Tüm Yönlü" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="360° Çevresel Ses" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            <TextBlock Text="Toplantı &amp; Grup Kaydı" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Stereo -->
                                    <RadioButton x:Name="RbPickupStereo"
                                                 GroupName="PickupGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="8,0,0,0"
                                                 Tag="Stereo"
                                                 Click="PickupPattern_Click">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="#0B0C0B" Margin="0,0,0,12">
                                                <Path Data="M8,5A7,7 0 0,0 1,12A7,7 0 0,0 8,19A7,7 0 0,0 15,12A7,7 0 0,0 8,5M16,5A7,7 0 0,0 9,12A7,7 0 0,0 16,19A7,7 0 0,0 23,12A7,7 0 0,0 16,5Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="22" Height="22"/>
                                            </Border>
                                            <TextBlock Text="Stereo" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sol &amp; Sağ Kanal Ayrımı" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            <TextBlock Text="Enstrüman &amp; ASMR" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- PAGE 2: RGB LAB (VISUALIZER, EFFECTS, LED PALETTE, BRIGHTNESS & SPEED)    -->
                    <!-- ========================================================================= -->
                    <Grid x:Name="PageRgbLab" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: EM68X RGB CAPSULE VISUALIZER CARD -->
                        <Border Grid.Column="0" Style="{StaticResource CreatorPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="EM68X LED ÖNİZLEME" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Seçili donanım aydınlatma profili" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Stylized Microphone + RGB Ring Visualizer -->
                                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16">
                                    <!-- Ambient Halo -->
                                    <Ellipse Width="190" Height="190" Opacity="0.22">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="BrushRgbGlow" Color="#F000FF"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="36"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Outer Chassis Ring -->
                                    <Ellipse Width="156" Height="156" Fill="#0A0B0A" Stroke="#242821" StrokeThickness="2"/>

                                    <!-- Active LED Ring -->
                                    <Border x:Name="RingRgbPreview" Width="128" Height="128" CornerRadius="64" BorderThickness="5" Background="#0D0E0D">
                                        <Border.BorderBrush>
                                            <SolidColorBrush x:Name="BrushRgbPreview" Color="#F000FF"/>
                                        </Border.BorderBrush>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                                  Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="30" Height="30" Margin="0,0,0,6"/>
                                            <TextBlock Text="EM68X RGB" FontSize="10.5" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Power & Active Color Readout -->
                                <Border Grid.Row="2" Background="#0A0B0A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Aydınlatma Gücü" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ChkRgbPower"
                                                      Style="{StaticResource CreatorToggleSwitch}"
                                                      Content=""
                                                      IsChecked="True"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Click="ChkRgbPower_Click"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Seçili Renk" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSelectedColorName" Text="Magenta" FontSize="12" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT: RGB EFFECTS, SWATCH PALETTE, BRIGHTNESS & SPEED -->
                        <Border Grid.Column="2" Style="{StaticResource CreatorPanel}">
                            <StackPanel>
                                <TextBlock Text="RGB AYDINLATMA LABORATUVARI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Mikrofon gövdesindeki LED efekt modunu, gerçek donanım rengini ve geçiş hızını yapılandırın"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,20"/>

                                <!-- 5 RGB Effect Modes -->
                                <TextBlock Text="AYDINLATMA EFEKT MODU" FontSize="11" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="5" Rows="1" Margin="0,0,0,22">
                                    <RadioButton x:Name="RbModeMonochrome"
                                                 GroupName="RgbModeGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="0,0,5,0" Padding="8,14"
                                                 IsChecked="True"
                                                 Tag="Monochrome"
                                                 Click="RgbMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Sabit" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Tek Renk" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbModeBreathing"
                                                 GroupName="RgbModeGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="3,0,3,0" Padding="8,14"
                                                 Tag="Breathing"
                                                 Click="RgbMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Nefes" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Yumuşak Nabız" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbModeGradient"
                                                 GroupName="RgbModeGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="3,0,3,0" Padding="8,14"
                                                 Tag="Gradient"
                                                 Click="RgbMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Geçişli" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Gradyan Akış" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbModeLoop"
                                                 GroupName="RgbModeGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="3,0,3,0" Padding="8,14"
                                                 Tag="RgbLoop"
                                                 Click="RgbMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="7 Renk" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Otomatik Döngü" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbModeSound"
                                                 GroupName="RgbModeGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="5,0,0,0" Padding="8,14"
                                                 Tag="SoundEffect"
                                                 Click="RgbMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Müzik" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sese Duyarlı" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <!-- 7 Hardware LED Color Swatches -->
                                <StackPanel x:Name="PanelColorSwatches" Margin="0,0,0,22">
                                    <TextBlock Text="DONANIM LED RENK PALETİ" FontSize="11" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"/>
                                    <Border Background="#0A0B0A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <RadioButton x:Name="RbColorRed" GroupName="RgbColorGroup" Style="{StaticResource CreatorColorSwatch}" Background="#FF2A2A" Tag="Red" ToolTip="Kırmızı" Click="RgbColor_Click"/>
                                            <RadioButton x:Name="RbColorMagenta" GroupName="RgbColorGroup" Style="{StaticResource CreatorColorSwatch}" Background="#F000FF" Tag="Magenta" IsChecked="True" ToolTip="Magenta" Click="RgbColor_Click"/>
                                            <RadioButton x:Name="RbColorBlue" GroupName="RgbColorGroup" Style="{StaticResource CreatorColorSwatch}" Background="#2563EB" Tag="Blue" ToolTip="Mavi" Click="RgbColor_Click"/>
                                            <RadioButton x:Name="RbColorCyan" GroupName="RgbColorGroup" Style="{StaticResource CreatorColorSwatch}" Background="#00F0FF" Tag="Cyan" ToolTip="Camgöbeği" Click="RgbColor_Click"/>
                                            <RadioButton x:Name="RbColorGreen" GroupName="RgbColorGroup" Style="{StaticResource CreatorColorSwatch}" Background="#10B981" Tag="Green" ToolTip="Yeşil" Click="RgbColor_Click"/>
                                            <RadioButton x:Name="RbColorYellow" GroupName="RgbColorGroup" Style="{StaticResource CreatorColorSwatch}" Background="#FACC15" Tag="Yellow" ToolTip="Sarı" Click="RgbColor_Click"/>
                                            <RadioButton x:Name="RbColorWhite" GroupName="RgbColorGroup" Style="{StaticResource CreatorColorSwatch}" Background="#FFFFFF" Tag="White" ToolTip="Beyaz / Geçişli Modda Turuncu" Click="RgbColor_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Brightness Slider -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="LED Işık Parlaklığı" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource TechValueBadge}" HorizontalAlignment="Right" MinWidth="54">
                                        <TextBlock x:Name="TxtBrightnessValue" Text="100%" FontSize="12" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="SliderBrightness"
                                        Style="{StaticResource CreatorSlider}"
                                        Foreground="{StaticResource BrushAccentCyan}"
                                        Minimum="0" Maximum="100" Value="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,0,0,18"
                                        ValueChanged="SliderBrightness_ValueChanged"
                                        PreviewMouseLeftButtonDown="RgbSlider_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="RgbSlider_PreviewMouseUp"/>

                                <!-- Animation Speed Slider -->
                                <StackPanel x:Name="PanelSpeedControl">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Efekt Animasyon Hızı" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource TechValueBadge}" HorizontalAlignment="Right" MinWidth="54">
                                            <TextBlock x:Name="TxtSpeedValue" Text="100%" FontSize="12" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource BrushAccentViolet}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderSpeed"
                                            Style="{StaticResource CreatorSlider}"
                                            Foreground="{StaticResource BrushAccentViolet}"
                                            Minimum="1" Maximum="100" Value="100"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderSpeed_ValueChanged"
                                            PreviewMouseLeftButtonDown="RgbSlider_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="RgbSlider_PreviewMouseUp"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- PAGE 3: CONTROLS (TOUCH SENSOR, GESTURE & MUTE BEHAVIOR)                  -->
                    <!-- ========================================================================= -->
                    <Grid x:Name="PageControls" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CreatorPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="ÜST DOKUNMATİK &amp; KIZILÖTESİ HAREKET SENSÖRÜ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Mikrofonun üst yüzeyindeki hızlı sessize alma (Mute) sensörünün çalışma davranışını seçin"
                                                   FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource TechValueBadge}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveSensorBadge" Text="El Hareketi" FontSize="12" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}"/>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="2" Rows="2">
                                    <RadioButton x:Name="RbCtrlNoClose"
                                                 GroupName="SensorGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="0,0,8,10"
                                                 Padding="18,20"
                                                 Tag="NoClose"
                                                 Click="SensorMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Sensör Devre Dışı (Kilitli)" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Üst sensör yanlışlıkla dokunmalara karşı kapatılır; mikrofon sürekli açık kalır."
                                                       FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbCtrlTouch"
                                                 GroupName="SensorGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="8,0,0,10"
                                                 Padding="18,20"
                                                 Tag="Touch"
                                                 Click="SensorMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Yalnızca Kapasitif Dokunmatik" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sadece parmağınızla mikrofonun üst yüzeyine fiziksel olarak dokunduğunuzda sessize alır."
                                                       FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbCtrlHandSweep"
                                                 GroupName="SensorGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="0,6,8,0"
                                                 Padding="18,20"
                                                 IsChecked="True"
                                                 Tag="HandSweep"
                                                 Click="SensorMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="El Hareketi (Temassız Geçiş)" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Mikrofona fiziksel temas etmeden, elinizi üstten geçirerek gürültüsüzce sessize alır."
                                                       FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbCtrlAnyKey"
                                                 GroupName="SensorGroup"
                                                 Style="{StaticResource CreatorModeTile}"
                                                 Margin="8,6,0,0"
                                                 Padding="18,20"
                                                 Tag="AnyKey"
                                                 Click="SensorMode_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Her İkisi (Dokunma + El Geçişi)" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Hem fiziksel dokunmayı hem de temassız el hareketini aynı anda algılar."
                                                       FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- SYSTEM & BACKGROUND BEHAVIOR INFO CARD -->
                        <Border Grid.Row="2" Style="{StaticResource CreatorPanel}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="MASAÜSTÜ &amp; SİSTEM TEPSİSİ (TRAY) DAVRANIŞI" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Pencereyi üst bardaki küçült (—) tuşuyla küçülttüğünüzde uygulama görev çubuğunda yer kaplamaz; sağ alt gizli simgelerde (System Tray) çalışmaya ve mikrofon bağlantısını korumaya devam eder."
                                               FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- PAGE 4: DEVICE & LOGS (BLE DISCOVERY, CONNECT/RESET, DIAGNOSTIC CONSOLE)  -->
                    <!-- ========================================================================= -->
                    <Grid x:Name="PageDeviceLogs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- BLUETOOTH & USB DEVICE MANAGEMENT PANEL -->
                        <Border Grid.Row="0" Style="{StaticResource CreatorPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="DONANIM BAĞLANTI YÖNETİMİ (BLUETOOTH LE &amp; USB)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Keşfedilen Godox EM68X ('LK*') cihazını seçin, bağlantıyı yenileyin veya Bluetooth adaptörünü sıfırlayın"
                                               FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbDevices"
                                              Style="{StaticResource CreatorComboBox}"
                                              Width="230"
                                              Margin="0,0,8,0"
                                              ToolTip="Keşfedilen Godox EM68X ('LK*') BLE Cihazları"/>
                                    <Button x:Name="BtnConnect"
                                            Content="Bağlan"
                                            Height="34"
                                            Style="{StaticResource CreatorPrimaryButton}"
                                            Margin="0,0,6,0"
                                            Click="BtnConnect_Click"/>
                                    <Button x:Name="BtnResetBle"
                                            Content="BT Sıfırla"
                                            Height="34"
                                            Style="{StaticResource CreatorSecondaryButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Bilgisayarın Bluetooth adaptörünü yeniden başlatıp mikrofona bağlanır"
                                            Click="BtnResetBle_Click"/>
                                    <Button x:Name="BtnRefreshStatus"
                                            Content="Yenile"
                                            Height="34"
                                            Style="{StaticResource CreatorSecondaryButton}"
                                            Click="BtnRefreshStatus_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- LIVE HARDWARE DIAGNOSTIC CONSOLE -->
                        <Border Grid.Row="2" Style="{StaticResource CreatorPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="CANLI DONANIM TANILAMA KONSOLU (BLE PROTOCOL STREAM)" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="TxtLastRawState"
                                                   Text="Durum: BLE bağlantısı bekleniyor..."
                                                   FontSize="11.5" FontFamily="Consolas" Foreground="{StaticResource BrushAccentCyan}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Content="Günlüğü Temizle"
                                            Style="{StaticResource CreatorSecondaryButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="12,5"
                                            FontSize="11.5"
                                            Click="BtnClearLog_Click"/>
                                </Grid>

                                <Border Grid.Row="2" Background="#070807" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8">
                                    <ListBox x:Name="LstProtocolLog"
                                             Background="Transparent"
                                             Foreground="{StaticResource BrushTextSecondary}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="11.5"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="6,3"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#121411"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1A1D18"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
