<Window x:Class="GodoxEM68XControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Godox EM68X Studio"
        Icon="pack://application:,,,/godox_em68x.ico"
        Width="1240" Height="830"
        MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="#080A0F"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ==================== BRUSHES & GRADIENTS ==================== -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6366F1" Offset="0.0"/>
            <GradientStop Color="#8B5CF6" Offset="0.5"/>
            <GradientStop Color="#06B6D4" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MicSliderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4F46E5" Offset="0.0"/>
            <GradientStop Color="#3B82F6" Offset="0.55"/>
            <GradientStop Color="#06B6D4" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MonitorSliderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#059669" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="0.6"/>
            <GradientStop Color="#34D399" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RgbSliderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EC4899" Offset="0.0"/>
            <GradientStop Color="#8B5CF6" Offset="0.5"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#121621" Offset="0.0"/>
            <GradientStop Color="#0E111A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ==================== CARD STYLE ==================== -->
        <Style x:Key="StudioCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#1E2436"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== WINDOW CAPTION BUTTONS ==================== -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2536"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== MODERN PRIMARY & SECONDARY BUTTONS ==================== -->
        <Style x:Key="PrimaryGlowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{StaticResource PrimaryGradient}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E2436"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPillButton" TargetType="Button">
            <Setter Property="Background" Value="#171C2B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#262F45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#21293E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#192032"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== MODERN TOGGLE SWITCH (CHECKBOX) ==================== -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Grid Width="44" Height="24">
                                <Border x:Name="track"
                                        CornerRadius="12"
                                        Background="#1B2132"
                                        BorderBrush="#2E3852"
                                        BorderThickness="1"/>
                                <Ellipse x:Name="thumb"
                                         Width="18" Height="18"
                                         Fill="#94A3B8"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== MODERN DARK COMBOBOX ==================== -->
        <ControlTemplate x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="10"
                        Background="#141826"
                        BorderBrush="#262F45"
                        BorderThickness="1"/>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      Fill="#94A3B8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4.5 4.5 L 9 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#4F46E5"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ModernComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,30,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Margin="0,4,0,0">
                                    <Border x:Name="DropDownBorder"
                                            Background="#141826"
                                            BorderThickness="1"
                                            BorderBrush="#334155"
                                            CornerRadius="10"
                                            Padding="4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E2E8F0"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#252F48"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#312E81"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== MODERN STUDIO FADER SLIDER ==================== -->
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="outerGlow"
                                     Width="20" Height="20"
                                     Fill="#FFFFFF"
                                     Stroke="#6366F1"
                                     StrokeThickness="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="10" ShadowDepth="0" Opacity="0.65"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerGlow" Property="Width" Value="22"/>
                                <Setter TargetName="outerGlow" Property="Height" Value="22"/>
                                <Setter TargetName="outerGlow" Property="Stroke" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="outerGlow" Property="Stroke" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernFaderSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#1B2133"/>
            <Setter Property="Foreground" Value="{StaticResource MicSliderGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="8"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        CornerRadius="4"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== SELECTABLE STUDIO MODE CARD (RADIOBUTTON) ==================== -->
        <Style x:Key="SelectableStudioCard" TargetType="RadioButton">
            <Setter Property="Background" Value="#151926"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#232A3E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#1B2133"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#1B1F3B"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="0" Opacity="0.28"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== GLOWING COLOR SWATCH RADIOBUTTON ==================== -->
        <Style x:Key="ColorSwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="outerRing"
                                     Width="40" Height="40"
                                     Stroke="Transparent"
                                     StrokeThickness="2.5"/>
                            <Ellipse x:Name="swatch"
                                     Width="28" Height="28"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="#44FFFFFF"
                                     StrokeThickness="1.2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerRing" Property="Stroke" Value="#64748B"/>
                                <Setter TargetName="swatch" Property="Width" Value="30"/>
                                <Setter TargetName="swatch" Property="Height" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerRing" Property="Stroke" Value="#FFFFFF"/>
                                <Setter TargetName="swatch" Property="Width" Value="30"/>
                                <Setter TargetName="swatch" Property="Height" Value="30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- OUTER WINDOW BORDER -->
    <Border Background="#080A0F" BorderBrush="#1F2537" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== 1. CUSTOM TOP TITLE & CONNECTION BAR ==================== -->
            <Border Grid.Row="0"
                    Background="#0C0F17"
                    BorderBrush="#1A2030"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="20,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource PrimaryGradient}" Margin="0,0,12,0">
                            <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GODOX EM68X" FontSize="15.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text=" STUDIO" FontSize="15.5" FontWeight="SemiBold" Foreground="#818CF8"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSubtitle"
                                       Text="Pro Audio &amp; RGB Kontrol Merkezi"
                                       FontSize="11.5" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Status Pills -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- BLE Status Pill -->
                        <Border Background="#131724" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="18" Padding="14,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="BleStatusDot" Width="9" Height="9" Fill="#F59E0B" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtBleStatus" Text="BLE Aranıyor..." FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- USB Status Pill -->
                        <Border Background="#131724" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="18" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="UsbStatusDot" Width="9" Height="9" Fill="#10B981" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtUsbStatus" Text="USB Ses: EM68X Aktif" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Device Selector & Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <ComboBox x:Name="CmbDevices"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="195"
                                  Margin="0,0,8,0"
                                  ToolTip="Keşfedilen Godox EM68X ('LK*') BLE Cihazları"/>
                        <Button x:Name="BtnConnect"
                                Content="Bağlan"
                                Style="{StaticResource PrimaryGlowButton}"
                                Margin="0,0,6,0"
                                Click="BtnConnect_Click"/>
                        <Button x:Name="BtnResetBle"
                                Content="BT Sıfırla"
                                Style="{StaticResource SoftPillButton}"
                                Margin="0,0,6,0"
                                ToolTip="Bilgisayarın Bluetooth adaptörünü yeniden başlatıp mikrofona bağlanır"
                                Click="BtnResetBle_Click"/>
                        <Button x:Name="BtnRefreshStatus"
                                Content="Yenile"
                                Style="{StaticResource SoftPillButton}"
                                Click="BtnRefreshStatus_Click"/>
                    </StackPanel>

                    <!-- Custom Window Minimize / Maximize / Close Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click" ToolTip="Küçült">
                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}" Click="BtnMaximize_Click" ToolTip="Ekranı Kapla">
                            <Rectangle Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Kapat">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 2. HELPFUL BLE CONNECTION HINT BANNER ==================== -->
            <Border x:Name="BannerBleHint"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#19162B"
                    BorderBrush="#4F46E5"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="22,14,22,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#312E81" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="!" FontSize="15" FontWeight="Bold" Foreground="#A5B4FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtBleHintMessage"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12.2"
                               Foreground="#E2E8F0"
                               Text="Mikrofonun Bluetooth (LK8353-53B3) yayını şu an algılanmadı. Mikrofon telefonunuza bağlıysa telefondan Bluetooth'u kapatın veya mikrofonun USB kablosunu 1 saniyeliğine çıkarıp tekrar takın; uygulama anında otomatik bağlanacaktır."/>
                    <Button Grid.Column="2"
                            Content="Tekrar Dene"
                            Style="{StaticResource PrimaryGlowButton}"
                            Padding="14,6"
                            Margin="12,0,0,0"
                            Click="BtnConnect_Click"/>
                </Grid>
            </Border>

            <!-- ==================== 3. MAIN STUDIO WORKSPACE ==================== -->
            <Grid Grid.Row="2" Margin="22,18,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT COLUMN: AUDIO MIXER, POLAR PATTERN & SENSOR ==================== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CARD 1: AUDIO & MONITOR MIXER -->
                    <Border Grid.Row="0" Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="SES &amp; MONİTÖR MİKSERİ" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Mikrofon kazancı ve gecikmesiz kulaklık monitör seviyesi"
                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkSyncWindowsAudio"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          Content="Windows Ses Eşitleme"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          ToolTip="Mikrofon ve kulaklık seviyesini hem BLE DSP hem Windows USB Ses üzerinde senkronize eder"/>
                            </Grid>

                            <!-- Live Input Peak Meter -->
                            <Border Background="#0B0E16" BorderBrush="#1A2133" BorderThickness="1" CornerRadius="11" Padding="14,10" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="CANLI GİRİŞ (USB)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="BarMicPeak"
                                                 Grid.Column="1"
                                                 Height="8"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Background="#161C2C"
                                                 Foreground="#10B981"
                                                 BorderThickness="0"/>
                                    <TextBlock x:Name="TxtMicPeak"
                                               Grid.Column="2"
                                               Text="0%"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#10B981"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Microphone Volume Fader -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#1E2540" Margin="0,0,10,0">
                                        <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                              Fill="#60A5FA" Stretch="Uniform" Width="14" Height="14"/>
                                    </Border>
                                    <TextBlock Text="Mikrofon Ses Seviyesi" FontSize="13.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="25%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,4,0" Tag="25" Click="BtnMicPreset_Click"/>
                                    <Button Content="50%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,4,0" Tag="50" Click="BtnMicPreset_Click"/>
                                    <Button Content="75%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,4,0" Tag="75" Click="BtnMicPreset_Click"/>
                                    <Button Content="100%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,10,0" Tag="100" Click="BtnMicPreset_Click"/>
                                    <Border Background="#1B2548" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="10,3" MinWidth="56">
                                        <TextBlock x:Name="TxtMicVolumeValue" Text="100%" FontSize="13" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Slider x:Name="SliderMicVolume"
                                    Style="{StaticResource ModernFaderSlider}"
                                    Foreground="{StaticResource MicSliderGradient}"
                                    Minimum="0" Maximum="100" Value="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,18"
                                    ValueChanged="SliderMicVolume_ValueChanged"
                                    PreviewMouseLeftButtonDown="AudioSlider_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="AudioSlider_PreviewMouseUp"/>

                            <!-- Headphone Monitor Volume Fader -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#0F2926" Margin="0,0,10,0">
                                        <Path Data="M12,1C7,1 3,5 3,10V17A3,3 0 0,0 6,20H9V12H5V10A7,7 0 0,1 12,3A7,7 0 0,1 19,10V12H15V20H18A3,3 0 0,0 21,17V10C21,5 17,1 12,1Z"
                                              Fill="#34D399" Stretch="Uniform" Width="14" Height="14"/>
                                    </Border>
                                    <TextBlock Text="Kulaklık Monitör Seviyesi" FontSize="13.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="0%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,4,0" Tag="0" Click="BtnMonPreset_Click"/>
                                    <Button Content="50%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,4,0" Tag="50" Click="BtnMonPreset_Click"/>
                                    <Button Content="64%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,4,0" Tag="64" Click="BtnMonPreset_Click"/>
                                    <Button Content="100%" Style="{StaticResource SoftPillButton}" Padding="9,3" FontSize="11" Margin="0,0,10,0" Tag="100" Click="BtnMonPreset_Click"/>
                                    <Border Background="#0B2E27" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10,3" MinWidth="56">
                                        <TextBlock x:Name="TxtMonitorVolumeValue" Text="64%" FontSize="13" FontWeight="Bold" Foreground="#6EE7B7" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Slider x:Name="SliderMonitorVolume"
                                    Style="{StaticResource ModernFaderSlider}"
                                    Foreground="{StaticResource MonitorSliderGradient}"
                                    Minimum="0" Maximum="100" Value="64"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderMonitorVolume_ValueChanged"
                                    PreviewMouseLeftButtonDown="AudioSlider_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="AudioSlider_PreviewMouseUp"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: POLAR PATTERN (PICKUP MODE) -->
                    <Border Grid.Row="2" Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="SES ALMA MODU (KUTUP DESENİ)" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Kayıt ortamınıza göre mikrofon kapsül yönlülüğünü seçin"
                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Background="#1B2135" BorderBrush="#2D3753" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActivePickupBadge" Text="Tüm Yönlü" FontSize="12" FontWeight="SemiBold" Foreground="#818CF8"/>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="4" Rows="1">
                                <!-- Cardioid -->
                                <RadioButton x:Name="RbPickupCardioid"
                                             GroupName="PickupGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="0,0,6,0"
                                             Tag="Cardioid"
                                             Click="PickupPattern_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#172036" Margin="0,0,0,8">
                                            <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                                                  Fill="#60A5FA" Stretch="Uniform" Width="17" Height="17"/>
                                        </Border>
                                        <TextBlock Text="Kardioid" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tek Kişi / Ön" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Bidirectional -->
                                <RadioButton x:Name="RbPickupBidirectional"
                                             GroupName="PickupGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="3,0,3,0"
                                             Tag="Bidirectional"
                                             Click="PickupPattern_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#201938" Margin="0,0,0,8">
                                            <Path Data="M12,6A3,3 0 0,0 9,9A3,3 0 0,0 12,12A3,3 0 0,0 15,9A3,3 0 0,0 12,6M12,14A3,3 0 0,0 9,17A3,3 0 0,0 12,20A3,3 0 0,0 15,17A3,3 0 0,0 12,14M12,4A5,5 0 0,1 17,9C17,10.5 16.3,11.8 15.2,12.7C16.3,13.6 17,15 17,16.5A5,5 0 0,1 12,21.5A5,5 0 0,1 7,16.5C7,15 7.7,13.6 8.8,12.7C7.7,11.8 7,10.5 7,9A5,5 0 0,1 12,4Z"
                                                  Fill="#A78BFA" Stretch="Uniform" Width="18" Height="18"/>
                                        </Border>
                                        <TextBlock Text="Çift Yönlü" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Karşılıklı / 2 Kişi" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Omnidirectional -->
                                <RadioButton x:Name="RbPickupOmni"
                                             GroupName="PickupGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="3,0,3,0"
                                             IsChecked="True"
                                             Tag="Omnidirectional"
                                             Click="PickupPattern_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#0F2926" Margin="0,0,0,8">
                                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7Z"
                                                  Fill="#34D399" Stretch="Uniform" Width="18" Height="18"/>
                                        </Border>
                                        <TextBlock Text="Tüm Yönlü" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="360° Grup / Ortam" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Stereo -->
                                <RadioButton x:Name="RbPickupStereo"
                                             GroupName="PickupGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="6,0,0,0"
                                             Tag="Stereo"
                                             Click="PickupPattern_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#2B162C" Margin="0,0,0,8">
                                            <Path Data="M8,5A7,7 0 0,0 1,12A7,7 0 0,0 8,19A7,7 0 0,0 15,12A7,7 0 0,0 8,5M16,5A7,7 0 0,0 9,12A7,7 0 0,0 16,19A7,7 0 0,0 23,12A7,7 0 0,0 16,5Z"
                                                  Fill="#F472B6" Stretch="Uniform" Width="19" Height="19"/>
                                        </Border>
                                        <TextBlock Text="Stereo" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sol &amp; Sağ Kanal" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: TOP MUTE SENSOR CONTROL MODE -->
                    <Border Grid.Row="4" Style="{StaticResource StudioCard}">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ÜST DOKUNMATİK &amp; EL SENSÖRÜ MODU" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Mikrofonun üst kısmındaki sessize alma (mute) sensörü davranışı"
                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Background="#1B2135" BorderBrush="#2D3753" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActiveSensorBadge" Text="El Hareketi" FontSize="12" FontWeight="SemiBold" Foreground="#C084FC"/>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="4" Rows="1">
                                <RadioButton x:Name="RbCtrlNoClose"
                                             GroupName="SensorGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="0,0,6,0"
                                             Padding="10,12"
                                             Tag="NoClose"
                                             Click="SensorMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Sensör Kapalı" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Kilitli / Sürekli Açık" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbCtrlTouch"
                                             GroupName="SensorGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="3,0,3,0"
                                             Padding="10,12"
                                             Tag="Touch"
                                             Click="SensorMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Dokunmatik" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Yalnızca Dokunma" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbCtrlHandSweep"
                                             GroupName="SensorGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="3,0,3,0"
                                             Padding="10,12"
                                             IsChecked="True"
                                             Tag="HandSweep"
                                             Click="SensorMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="El Hareketi" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Temassız El Geçişi" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbCtrlAnyKey"
                                             GroupName="SensorGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="6,0,0,0"
                                             Padding="10,12"
                                             Tag="AnyKey"
                                             Click="SensorMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Her İkisi" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Dokunma + El Geçişi" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== RIGHT COLUMN: RGB LIGHTING STUDIO & PROTOCOL MONITOR ==================== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CARD 1: RGB LIGHTING STUDIO -->
                    <Border Grid.Row="0" Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <!-- Header + Glowing RGB Preview Orb + Toggle Switch -->
                            <Grid Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="42" Height="42" Margin="0,0,12,0">
                                        <Ellipse Width="42" Height="42" Opacity="0.35">
                                            <Ellipse.Fill>
                                                <SolidColorBrush x:Name="BrushRgbGlow" Color="#FF00FF"/>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <BlurEffect Radius="14"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#55FFFFFF" BorderThickness="1.5">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="BrushRgbPreview" Color="#FF00FF"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="RGB AYDINLATMA STÜDYOSU" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Mikrofon gövdesi ambiyans efektleri, renk ve parlaklık"
                                                   FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <CheckBox x:Name="ChkRgbPower"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          Content="RGB Aydınlatma"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Click="ChkRgbPower_Click"/>
                            </Grid>

                            <!-- 5 RGB Effect Modes -->
                            <TextBlock Text="AYDINLATMA EFEKTİ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <UniformGrid Columns="5" Rows="1" Margin="0,0,0,18">
                                <RadioButton x:Name="RbModeMonochrome"
                                             GroupName="RgbModeGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="0,0,4,0" Padding="6,11"
                                             IsChecked="True"
                                             Tag="Monochrome"
                                             Click="RgbMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Sabit" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tek Renk" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbModeBreathing"
                                             GroupName="RgbModeGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="2,0,2,0" Padding="6,11"
                                             Tag="Breathing"
                                             Click="RgbMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Nefes" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Yumuşak" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbModeGradient"
                                             GroupName="RgbModeGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="2,0,2,0" Padding="6,11"
                                             Tag="Gradient"
                                             Click="RgbMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Geçişli" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Gradyan" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbModeLoop"
                                             GroupName="RgbModeGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="2,0,2,0" Padding="6,11"
                                             Tag="RgbLoop"
                                             Click="RgbMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="7 Renk" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Döngü" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RbModeSound"
                                             GroupName="RgbModeGroup"
                                             Style="{StaticResource SelectableStudioCard}"
                                             Margin="4,0,0,0" Padding="6,11"
                                             Tag="SoundEffect"
                                             Click="RgbMode_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Müzik" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sese Duyarlı" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- 7 Color Swatches -->
                            <StackPanel x:Name="PanelColorSwatches" Margin="0,0,0,18">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="RENK PALETİ" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSelectedColorName" Text="Magenta" FontSize="12" FontWeight="SemiBold" Foreground="#F472B6" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="#0B0E16" BorderBrush="#1A2133" BorderThickness="1" CornerRadius="12" Padding="10,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <RadioButton x:Name="RbColorRed" GroupName="RgbColorGroup" Style="{StaticResource ColorSwatchRadio}" Background="#FF2A2A" Tag="Red" ToolTip="Kırmızı" Click="RgbColor_Click"/>
                                        <RadioButton x:Name="RbColorMagenta" GroupName="RgbColorGroup" Style="{StaticResource ColorSwatchRadio}" Background="#F000FF" Tag="Magenta" IsChecked="True" ToolTip="Magenta" Click="RgbColor_Click"/>
                                        <RadioButton x:Name="RbColorBlue" GroupName="RgbColorGroup" Style="{StaticResource ColorSwatchRadio}" Background="#2563EB" Tag="Blue" ToolTip="Mavi" Click="RgbColor_Click"/>
                                        <RadioButton x:Name="RbColorCyan" GroupName="RgbColorGroup" Style="{StaticResource ColorSwatchRadio}" Background="#00F0FF" Tag="Cyan" ToolTip="Camgöbeği" Click="RgbColor_Click"/>
                                        <RadioButton x:Name="RbColorGreen" GroupName="RgbColorGroup" Style="{StaticResource ColorSwatchRadio}" Background="#10B981" Tag="Green" ToolTip="Yeşil" Click="RgbColor_Click"/>
                                        <RadioButton x:Name="RbColorYellow" GroupName="RgbColorGroup" Style="{StaticResource ColorSwatchRadio}" Background="#FACC15" Tag="Yellow" ToolTip="Sarı" Click="RgbColor_Click"/>
                                        <RadioButton x:Name="RbColorWhite" GroupName="RgbColorGroup" Style="{StaticResource ColorSwatchRadio}" Background="#FFFFFF" Tag="White" ToolTip="Beyaz / Geçişli Modda Turuncu" Click="RgbColor_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Brightness Slider -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Işık Parlaklığı" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock x:Name="TxtBrightnessValue" Text="100%" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderBrightness"
                                    Style="{StaticResource ModernFaderSlider}"
                                    Foreground="{StaticResource RgbSliderGradient}"
                                    Minimum="0" Maximum="100" Value="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,14"
                                    ValueChanged="SliderBrightness_ValueChanged"
                                    PreviewMouseLeftButtonDown="RgbSlider_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="RgbSlider_PreviewMouseUp"/>

                            <!-- Speed Slider -->
                            <StackPanel x:Name="PanelSpeedControl">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Animasyon Hızı" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock x:Name="TxtSpeedValue" Text="100%" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderSpeed"
                                        Style="{StaticResource ModernFaderSlider}"
                                        Foreground="{StaticResource PrimaryGradient}"
                                        Minimum="1" Maximum="100" Value="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="SliderSpeed_ValueChanged"
                                        PreviewMouseLeftButtonDown="RgbSlider_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="RgbSlider_PreviewMouseUp"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: COMPACT LIVE HARDWARE TELEMETRY & LOG -->
                    <Border Grid.Row="2" Style="{StaticResource StudioCard}" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="DONANIM İLETİŞİM GÜNLÜĞÜ" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock x:Name="TxtLastRawState"
                                               Text="Durum: BLE bağlantısı bekleniyor..."
                                               FontSize="11" FontFamily="Consolas" Foreground="#818CF8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Content="Temizle"
                                        Style="{StaticResource SoftPillButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="10,4"
                                        FontSize="11"
                                        Click="BtnClearLog_Click"/>
                            </Grid>

                            <Border Grid.Row="2" Background="#080A10" BorderBrush="#192032" BorderThickness="1" CornerRadius="10" Padding="6">
                                <ListBox x:Name="LstProtocolLog"
                                         Background="Transparent"
                                         Foreground="#94A3B8"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
